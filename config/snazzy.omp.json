{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "console_title_template": "{{ .Folder }}{{ if .Root }} (admin){{ end }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "diamond",
          "leading_diamond": "",
          "foreground": "#282A36",
          "background": "#FF6AC1",
          "template": " {{ .Icon }} "
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#282A36",
          "background": "#57C7FF",
          "properties": {
            "style": "agnoster_short",
            "max_depth": 3,
            "home_icon": "~",
            "folder_separator_icon": "  "
          },
          "template": " {{ .Path }} "
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#282A36",
          "background": "#5AF78E",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#F3F99D{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#FF6AC1{{ end }}",
            "{{ if gt .Ahead 0 }}#9AEDFE{{ end }}",
            "{{ if gt .Behind 0 }}#9AEDFE{{ end }}"
          ],
          "properties": {
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "branch_max_length": 25
          },
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }} "
        },
        {
          "type": "node",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#5AF78E",
          "background": "#3A3D4D",
          "properties": {
            "fetch_version": true,
            "display_mode": "files"
          },
          "template": "  {{ .Full }} "
        },
        {
          "type": "python",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#F3F99D",
          "background": "#3A3D4D",
          "properties": {
            "fetch_version": true,
            "fetch_virtual_env": true,
            "display_mode": "files"
          },
          "template": "  {{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }} "
        },
        {
          "type": "executiontime",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#282A36",
          "background": "#F3F99D",
          "properties": {
            "threshold": 500,
            "style": "austin"
          },
          "template": "  {{ .FormattedMs }} "
        },
        {
          "type": "status",
          "style": "diamond",
          "trailing_diamond": "",
          "foreground": "#EFF0EB",
          "background": "#FF5C57",
          "properties": {
            "always_enabled": false
          },
          "template": "  {{ .Code }} "
        }
      ]
    },
    {
      "type": "rprompt",
      "overflow": "hidden",
      "segments": [
        {
          "type": "time",
          "style": "plain",
          "foreground": "#686868",
          "properties": {
            "time_format": "15:04:05"
          },
          "template": "{{ .CurrentDate | date .Format }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground": "#5AF78E",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#FF5C57{{ end }}"
          ],
          "properties": {
            "always_enabled": true
          },
          "template": "❯"
        }
      ]
    }
  ]
}