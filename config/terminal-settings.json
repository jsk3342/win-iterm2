{
    "$help": "https://aka.ms/terminal-documentation",
    "$schema": "https://aka.ms/terminal-profiles-schema",
    "actions": [],
    "copyFormatting": "none",
    "copyOnSelect": true,
    "defaultProfile": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
    "initialCols": 120,
    "initialRows": 32,
    "tabWidthMode": "equal",
    "useAcrylicInTabRow": true,
    "alwaysShowTabs": true,
    "showTabsInTitlebar": true,
    "focusFollowMouse": false,
    "keybindings":
    [
        {
            "id": "Terminal.CopyToClipboard",
            "keys": "ctrl+c"
        },
        {
            "id": "Terminal.PasteFromClipboard",
            "keys": "ctrl+v"
        },
        {
            "id": "Terminal.SplitPaneRight",
            "keys": "ctrl+shift+d"
        },
        {
            "id": "Terminal.SplitPaneDown",
            "keys": "ctrl+shift+e"
        },
        {
            "id": "Terminal.ClosePane",
            "keys": "ctrl+shift+w"
        },
        {
            "id": "Terminal.MoveFocusLeft",
            "keys": "alt+left"
        },
        {
            "id": "Terminal.MoveFocusRight",
            "keys": "alt+right"
        },
        {
            "id": "Terminal.MoveFocusUp",
            "keys": "alt+up"
        },
        {
            "id": "Terminal.MoveFocusDown",
            "keys": "alt+down"
        },
        {
            "id": "Terminal.FindText",
            "keys": "ctrl+shift+f"
        },
        {
            "id": "Terminal.ResetFontSize",
            "keys": "ctrl+0"
        },
        {
            "id": "Terminal.IncreaseFontSize",
            "keys": "ctrl+plus"
        },
        {
            "id": "Terminal.DecreaseFontSize",
            "keys": "ctrl+minus"
        }
    ],
    "newTabMenu":
    [
        {
            "type": "remainingProfiles"
        }
    ],
    "profiles":
    {
        "defaults":
        {
            "colorScheme": "Snazzy",
            "font":
            {
                "face": "MesloLGM Nerd Font",
                "size": 11,
                "weight": "normal"
            },
            "useAcrylic": true,
            "opacity": 88,
            "padding": "14, 12, 14, 12",
            "cursorShape": "bar",
            "antialiasingMode": "grayscale",
            "scrollbarState": "hidden",
            "snapOnInput": true,
            "historySize": 20000,
            "bellStyle": "none"
        },
